# Order Service Environment Variables
# ==================================
# Copy this file to order-service.env and update values for production

# Service configuration
SERVER_PORT=8080
SERVER_HOST=0.0.0.0

# Database configuration
DATABASE_HOST=order-db
DATABASE_PORT=5432
DATABASE_NAME=orderdb
DATABASE_USERNAME=orderadmin
DATABASE_PASSWORD=orderpass123

# Redis configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_POOL_MAX_ACTIVE=8
REDIS_POOL_MAX_IDLE=8
REDIS_POOL_MAX_WAIT=-1ms
REDIS_TIMEOUT=5000ms

# RabbitMQ configuration
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=admin
RABBITMQ_PASSWORD=rabbitmq123

# Service URLs (for inter-service communication)
USER_SERVICE_URL=http://user-service:8080
PRODUCT_SERVICE_URL=http://product-service:8080

# Logging
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_APP=DEBUG
