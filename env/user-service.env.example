# User Service Environment variables
# ==================
SERVICE configuration
# ==================================
# Service configuration
SERVER.port=8080
host=0.0.0
db_port=5432

# Database credentials (CHANGE in production!)
DB_username=useradmin
db_password=userpass123

# Redis configuration
redis_host=redis
redis_port=6379

# Connection pool settings
redis_pool_max_active=8
redis_pool_max_idle=300000

redis_pool_max_wait=-1

redis_timeout=5000

# RabbitMQ configuration
rabbitmq_host=rabbitmq
rabbitmq_port=5672
rabbitmq_username=admin
rabbitmq_password=rabbitmq123

# JWT configuration
jwt_secret=your-very-long-jwt-secret-key-change-me-in-production
jwt_expiration=86400000

# Logging
logging_level=INFO
logging_config=classpath:/logs

