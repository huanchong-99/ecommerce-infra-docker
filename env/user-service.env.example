# User Service Environment Variables
# ==================================
# Copy this file to user-service.env and update values for production

# Service configuration
SERVER_PORT=8080
SERVER_HOST=0.0.0.0

# Database configuration
DATABASE_HOST=user-db
DATABASE_PORT=5432
DATABASE_NAME=userdb
DATABASE_USERNAME=useradmin
DATABASE_PASSWORD=userpass123

# Redis configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_POOL_MAX_ACTIVE=8
REDIS_POOL_MAX_IDLE=8
REDIS_POOL_MAX_WAIT=-1ms
REDIS_TIMEOUT=5000ms

# RabbitMQ configuration
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=admin
RABBITMQ_PASSWORD=rabbitmq123

# JWT configuration (CHANGE IN PRODUCTION!)
JWT_SECRET=your-very-long-jwt-secret-key-change-me-in-production
JWT_EXPIRATION=86400000

# Logging
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_APP=DEBUG

