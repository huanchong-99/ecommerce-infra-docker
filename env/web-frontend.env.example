# Web Frontend Environment Variables
# ==================================
# Copy this file to web-frontend.env and update values for production

# Node environment
NODE_ENV=production

# API Gateway URL (internal)
API_GATEWAY_URL=http://api-gateway

# Public API URL (for browser clients)
NEXT_PUBLIC_API_URL=http://localhost/api

# Optional: Analytics and monitoring
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_SENTRY_DSN=

